<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.life</groupId>
        <artifactId>life-social</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>
    <artifactId>life-server</artifactId>
    <name>Archetype - life-server</name>
    <url>http://maven.apache.org</url>
    <dependencies>
        <dependency>
            <groupId>com.life</groupId>
            <artifactId>life-common</artifactId>
            <version>0.0.1-SNAPSHOT</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>com.life</groupId>
            <artifactId>life-pojo</artifactId>
            <version>0.0.1-SNAPSHOT</version>
            <scope>compile</scope>
        </dependency>
<!--        Bcypt加盐-->
        <dependency>
            <groupId>org.mindrot</groupId>
            <artifactId>jbcrypt</artifactId>
            <version>0.4</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
        </dependency>
<!--        pagehelper 已移除: 分页统一走MP PaginationInnerInterceptor;
            且其 starter 的 @AutoConfiguration(after=MybatisAutoConfiguration.class)
            在排除 mybatis-spring-boot-starter 后启动即抛 ClassNotFoundException-->
    </dependencies>

    <build>
        <plugins>
            <!-- spring-boot repackage 只在启动类所在的 life-server 模块执行，库模块不打包 fat jar -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
