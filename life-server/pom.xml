<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.life</groupId>
        <artifactId>life-social</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>
    <artifactId>life-server</artifactId>
    <name>Archetype - life-server</name>
    <url>http://maven.apache.org</url>
    <dependencies>
        <dependency>
            <groupId>com.life</groupId>
            <artifactId>life-common</artifactId>
            <version>0.0.1-SNAPSHOT</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>com.life</groupId>
            <artifactId>life-pojo</artifactId>
            <version>0.0.1-SNAPSHOT</version>
            <scope>compile</scope>
        </dependency>
<!--        Bcypt加盐-->
        <dependency>
            <groupId>org.mindrot</groupId>
            <artifactId>jbcrypt</artifactId>
            <version>0.4</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
        </dependency>
        <!-- 2.11 多级缓存 L1: Caffeine 本地热点页(版本由SpringBoot父POM管理);
             不走starter-cache注解体系, 直接手工组装, 与L2 Redis分层语义更明确 -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>
        <!-- 2.10 接口层限流: Sentinel 单机规则(资源级QPS+单用户热点参数), 无dashboard, 规则代码化(SentinelRuleConfig) -->
        <dependency>
            <groupId>com.alibaba.csp</groupId>
            <artifactId>sentinel-core</artifactId>
            <version>1.8.8</version>
        </dependency>
        <dependency>
            <groupId>com.alibaba.csp</groupId>
            <artifactId>sentinel-parameter-flow-control</artifactId>
            <version>1.8.8</version>
        </dependency>
        <!-- 4.10 接口文档: SpringDoc OpenAPI (swagger-ui: /swagger-ui.html, 文档: /v3/api-docs);
             路径未挂登录拦截器, 本地可直接访问 -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.7.0</version>
        </dependency>
        <!-- 4.10 单元测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- SpringBoot WebSocket starter -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>
        <!-- Spring AMQP RabbitMQ starter -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>
        <!--        pagehelper 已移除: 分页统一走MP PaginationInnerInterceptor;
                    且其 starter 的 @AutoConfiguration(after=MybatisAutoConfiguration.class)
                    在排除 mybatis-spring-boot-starter 后启动即抛 ClassNotFoundException-->
    </dependencies>

    <build>
        <plugins>
            <!-- spring-boot repackage 只在启动类所在的 life-server 模块执行，库模块不打包 fat jar -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
