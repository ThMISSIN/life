<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.life.mapper.LifeProductMapper">

    <!-- 自定义SQL不走MP逻辑删除拦截, 需手动带上 deleted = 0;
         status为null时不按状态过滤(仅管理端), C端由服务层强制传入1 -->
    <select id="queryList" resultType="com.life.entity.LifeProduct">
        select *
        from life_product
        where deleted = 0
        <if test="query.status != null">
            and status = #{query.status}
        </if>
        <if test="query.categoryId != null">
            and category_id = #{query.categoryId}
        </if>
        <if test="query.keyword != null and query.keyword != ''">
            and (name like concat('%', #{query.keyword}, '%')
                 or shop_name like concat('%', #{query.keyword}, '%'))
        </if>
        <choose>
            <when test="query.sortType != null and query.sortType == 2">
                order by sales desc, id desc
            </when>
            <when test="query.sortType != null and query.sortType == 3">
                order by price asc, id desc
            </when>
            <when test="query.sortType != null and query.sortType == 4">
                order by price desc, id desc
            </when>
            <otherwise>
                order by sort asc, id desc
            </otherwise>
        </choose>
    </select>
</mapper>
