<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.life.mapper.LifeBenefitMapper">

    <!-- 自定义SQL不走MP逻辑删除拦截, 需手动带上 deleted = 0 -->
    <select id="queryList" resultType="com.life.entity.LifeBenefit">
        select *
        from life_benefit
        where deleted = 0
          and status = 1
        <if test="query.categoryId != null">
            and category_id = #{query.categoryId}
        </if>
        <if test="query.keyword != null and query.keyword != ''">
            and name like concat('%', #{query.keyword}, '%')
        </if>
        <choose>
            <when test="query.sortType != null and query.sortType == 2">
                order by sales desc, id desc
            </when>
            <when test="query.sortType != null and query.sortType == 3">
                order by points_price asc, id desc
            </when>
            <when test="query.sortType != null and query.sortType == 4">
                order by points_price desc, id desc
            </when>
            <otherwise>
                order by sort asc, id desc
            </otherwise>
        </choose>
    </select>
</mapper>
