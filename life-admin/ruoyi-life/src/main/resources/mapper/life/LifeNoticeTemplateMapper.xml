<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.life.mapper.LifeNoticeTemplateMapper">

    <resultMap type="LifeNoticeTemplate" id="LifeNoticeTemplateResult">
        <id     property="id"              column="id"/>
        <result property="name"            column="name"/>
        <result property="code"            column="code"/>
        <result property="type"            column="type"/>
        <result property="titleTemplate"   column="title_template"/>
        <result property="contentTemplate" column="content_template"/>
        <result property="status"          column="status"/>
        <result property="createTime"      column="create_time"/>
        <result property="updateTime"      column="update_time"/>
        <result property="creater"         column="creater"/>
        <result property="updater"         column="updater"/>
        <result property="deleted"         column="deleted"/>
    </resultMap>

    <sql id="selectNoticeTemplateVo">
        select id, name, code, type, title_template, content_template, status,
               create_time, update_time, creater, updater, deleted
        from life_notice_template
    </sql>

    <select id="selectLifeNoticeTemplateList" parameterType="com.ruoyi.life.domain.query.LifeNoticeTemplateQuery" resultMap="LifeNoticeTemplateResult">
        <include refid="selectNoticeTemplateVo"/>
        where deleted = 0
        <if test="name != null and name != ''">
            and name like concat('%', #{name}, '%')
        </if>
        <if test="type != null">
            and type = #{type}
        </if>
        <if test="status != null">
            and status = #{status}
        </if>
        order by id desc
    </select>

    <select id="selectLifeNoticeTemplateById" parameterType="Long" resultMap="LifeNoticeTemplateResult">
        <include refid="selectNoticeTemplateVo"/>
        where deleted = 0 and id = #{id}
    </select>

    <select id="selectByCode" parameterType="String" resultMap="LifeNoticeTemplateResult">
        <include refid="selectNoticeTemplateVo"/>
        where deleted = 0 and code = #{code}
    </select>

    <select id="countByCode" resultType="int">
        select count(*) from life_notice_template where deleted = 0 and code = #{code}
        <if test="excludeId != null">
            and id != #{excludeId}
        </if>
    </select>

    <insert id="insertLifeNoticeTemplate" parameterType="LifeNoticeTemplate" useGeneratedKeys="true" keyProperty="id">
        insert into life_notice_template
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="name != null">name,</if>
            <if test="code != null">code,</if>
            <if test="type != null">type,</if>
            <if test="titleTemplate != null">title_template,</if>
            <if test="contentTemplate != null">content_template,</if>
            <if test="status != null">status,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="creater != null">creater,</if>
            <if test="updater != null">updater,</if>
            <if test="deleted != null">deleted,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="name != null">#{name},</if>
            <if test="code != null">#{code},</if>
            <if test="type != null">#{type},</if>
            <if test="titleTemplate != null">#{titleTemplate},</if>
            <if test="contentTemplate != null">#{contentTemplate},</if>
            <if test="status != null">#{status},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="creater != null">#{creater},</if>
            <if test="updater != null">#{updater},</if>
            <if test="deleted != null">#{deleted},</if>
        </trim>
    </insert>

    <update id="updateLifeNoticeTemplate" parameterType="LifeNoticeTemplate">
        update life_notice_template
        <trim prefix="SET" suffixOverrides=",">
            <if test="name != null">name = #{name},</if>
            <if test="code != null">code = #{code},</if>
            <if test="type != null">type = #{type},</if>
            <if test="titleTemplate != null">title_template = #{titleTemplate},</if>
            <if test="contentTemplate != null">content_template = #{contentTemplate},</if>
            <if test="status != null">status = #{status},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="updater != null">updater = #{updater},</if>
        </trim>
        where id = #{id} and deleted = 0
    </update>

    <!-- 逻辑删除, 与C端 MyBatis-Plus @TableLogic 行为一致 -->
    <update id="deleteLifeNoticeTemplateById" parameterType="Long">
        update life_notice_template set deleted = 1 where id = #{id}
    </update>

</mapper>
