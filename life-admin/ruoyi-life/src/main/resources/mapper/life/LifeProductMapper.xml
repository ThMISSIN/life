<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.life.mapper.LifeProductMapper">

    <resultMap type="LifeProduct" id="LifeProductResult">
        <id     property="id"            column="id"/>
        <result property="name"          column="name"/>
        <result property="categoryId"    column="category_id"/>
        <result property="categoryName"  column="category_name"/>
        <result property="description"   column="description"/>
        <result property="coverImage"    column="cover_image"/>
        <result property="images"        column="images"/>
        <result property="tags"          column="tags"/>
        <result property="shopName"      column="shop_name"/>
        <result property="location"      column="location"/>
        <result property="price"         column="price"/>
        <result property="originalPrice" column="original_price"/>
        <result property="pointsPrice"   column="points_price"/>
        <result property="perUserLimit"  column="per_user_limit"/>
        <result property="minLevel"      column="min_level"/>
        <result property="stock"         column="stock"/>
        <result property="sales"         column="sales"/>
        <result property="status"        column="status"/>
        <result property="sort"          column="sort"/>
        <result property="createTime"    column="create_time"/>
        <result property="updateTime"    column="update_time"/>
        <result property="creater"       column="creater"/>
        <result property="updater"       column="updater"/>
        <result property="deleted"       column="deleted"/>
    </resultMap>

    <sql id="selectProductVo">
        select p.id, p.name, p.category_id, p.description, p.cover_image, p.images, p.tags,
               p.shop_name, p.location, p.price, p.original_price, p.points_price, p.per_user_limit,
               p.min_level, p.stock, p.sales, p.status, p.sort, p.create_time, p.update_time,
               p.creater, p.updater, p.deleted,
               c.name as category_name
        from life_product p
        left join life_product_category c on c.id = p.category_id and c.deleted = 0
    </sql>

    <!-- 管理端分页: status不传查全部(含下架); 排序口径与C端 LifeProductMapper.queryList 一致 -->
    <select id="selectLifeProductList" parameterType="com.ruoyi.life.domain.query.LifeProductQuery" resultMap="LifeProductResult">
        <include refid="selectProductVo"/>
        where p.deleted = 0
        <if test="status != null">
            and p.status = #{status}
        </if>
        <if test="categoryId != null">
            and p.category_id = #{categoryId}
        </if>
        <if test="keyword != null and keyword != ''">
            and (p.name like concat('%', #{keyword}, '%')
                 or p.shop_name like concat('%', #{keyword}, '%'))
        </if>
        <choose>
            <when test="sortType != null and sortType == 2">
                order by p.sales desc, p.id desc
            </when>
            <when test="sortType != null and sortType == 3">
                order by p.price asc, p.id desc
            </when>
            <when test="sortType != null and sortType == 4">
                order by p.price desc, p.id desc
            </when>
            <otherwise>
                order by p.sort asc, p.id desc
            </otherwise>
        </choose>
    </select>

    <select id="selectLifeProductById" parameterType="Long" resultMap="LifeProductResult">
        <include refid="selectProductVo"/>
        where p.deleted = 0 and p.id = #{id}
    </select>

    <select id="countByCategoryId" parameterType="Long" resultType="int">
        select count(*) from life_product where deleted = 0 and category_id = #{categoryId}
    </select>

    <insert id="insertLifeProduct" parameterType="LifeProduct" useGeneratedKeys="true" keyProperty="id">
        insert into life_product
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="name != null">name,</if>
            <if test="categoryId != null">category_id,</if>
            <if test="description != null">description,</if>
            <if test="coverImage != null">cover_image,</if>
            <if test="images != null">images,</if>
            <if test="tags != null">tags,</if>
            <if test="shopName != null">shop_name,</if>
            <if test="location != null">location,</if>
            <if test="price != null">price,</if>
            <if test="originalPrice != null">original_price,</if>
            <if test="pointsPrice != null">points_price,</if>
            <if test="perUserLimit != null">per_user_limit,</if>
            <if test="minLevel != null">min_level,</if>
            <if test="stock != null">stock,</if>
            <if test="sales != null">sales,</if>
            <if test="status != null">status,</if>
            <if test="sort != null">sort,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="creater != null">creater,</if>
            <if test="updater != null">updater,</if>
            <if test="deleted != null">deleted,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="name != null">#{name},</if>
            <if test="categoryId != null">#{categoryId},</if>
            <if test="description != null">#{description},</if>
            <if test="coverImage != null">#{coverImage},</if>
            <if test="images != null">#{images},</if>
            <if test="tags != null">#{tags},</if>
            <if test="shopName != null">#{shopName},</if>
            <if test="location != null">#{location},</if>
            <if test="price != null">#{price},</if>
            <if test="originalPrice != null">#{originalPrice},</if>
            <if test="pointsPrice != null">#{pointsPrice},</if>
            <if test="perUserLimit != null">#{perUserLimit},</if>
            <if test="minLevel != null">#{minLevel},</if>
            <if test="stock != null">#{stock},</if>
            <if test="sales != null">#{sales},</if>
            <if test="status != null">#{status},</if>
            <if test="sort != null">#{sort},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="creater != null">#{creater},</if>
            <if test="updater != null">#{updater},</if>
            <if test="deleted != null">#{deleted},</if>
        </trim>
    </insert>

    <update id="updateLifeProduct" parameterType="LifeProduct">
        update life_product
        <trim prefix="SET" suffixOverrides=",">
            <if test="name != null">name = #{name},</if>
            <if test="categoryId != null">category_id = #{categoryId},</if>
            <if test="description != null">description = #{description},</if>
            <if test="coverImage != null">cover_image = #{coverImage},</if>
            <if test="images != null">images = #{images},</if>
            <if test="tags != null">tags = #{tags},</if>
            <if test="shopName != null">shop_name = #{shopName},</if>
            <if test="location != null">location = #{location},</if>
            <if test="price != null">price = #{price},</if>
            <if test="originalPrice != null">original_price = #{originalPrice},</if>
            <if test="pointsPrice != null">points_price = #{pointsPrice},</if>
            <if test="perUserLimit != null">per_user_limit = #{perUserLimit},</if>
            <if test="minLevel != null">min_level = #{minLevel},</if>
            <if test="stock != null">stock = #{stock},</if>
            <if test="sales != null">sales = #{sales},</if>
            <if test="status != null">status = #{status},</if>
            <if test="sort != null">sort = #{sort},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="updater != null">updater = #{updater},</if>
        </trim>
        where id = #{id} and deleted = 0
    </update>

    <!-- 逻辑删除, 与C端 MyBatis-Plus @TableLogic 行为一致 -->
    <update id="deleteLifeProductById" parameterType="Long">
        update life_product set deleted = 1 where id = #{id}
    </update>

</mapper>
