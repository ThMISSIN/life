<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.life.mapper.LifeAnnouncementMapper">

    <resultMap type="LifeAnnouncement" id="LifeAnnouncementResult">
        <id     property="id"          column="id"/>
        <result property="title"       column="title"/>
        <result property="content"     column="content"/>
        <result property="type"        column="type"/>
        <result property="top"         column="top"/>
        <result property="status"      column="status"/>
        <result property="publishTime" column="publish_time"/>
        <result property="createTime"  column="create_time"/>
        <result property="updateTime"  column="update_time"/>
        <result property="creater"     column="creater"/>
        <result property="updater"     column="updater"/>
        <result property="deleted"     column="deleted"/>
    </resultMap>

    <sql id="selectAnnouncementVo">
        select id, title, content, type, top, status, publish_time,
               create_time, update_time, creater, updater, deleted
        from life_announcement
    </sql>

    <select id="selectLifeAnnouncementList" parameterType="com.ruoyi.life.domain.query.LifeAnnouncementQuery" resultMap="LifeAnnouncementResult">
        <include refid="selectAnnouncementVo"/>
        where deleted = 0
        <if test="keyword != null and keyword != ''">
            and title like concat('%', #{keyword}, '%')
        </if>
        <if test="type != null">
            and type = #{type}
        </if>
        <if test="status != null">
            and status = #{status}
        </if>
        order by top desc, publish_time desc, id desc
    </select>

    <select id="selectLifeAnnouncementById" parameterType="Long" resultMap="LifeAnnouncementResult">
        <include refid="selectAnnouncementVo"/>
        where deleted = 0 and id = #{id}
    </select>

    <insert id="insertLifeAnnouncement" parameterType="LifeAnnouncement" useGeneratedKeys="true" keyProperty="id">
        insert into life_announcement
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="title != null">title,</if>
            <if test="content != null">content,</if>
            <if test="type != null">type,</if>
            <if test="top != null">top,</if>
            <if test="status != null">status,</if>
            <if test="publishTime != null">publish_time,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="creater != null">creater,</if>
            <if test="updater != null">updater,</if>
            <if test="deleted != null">deleted,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="title != null">#{title},</if>
            <if test="content != null">#{content},</if>
            <if test="type != null">#{type},</if>
            <if test="top != null">#{top},</if>
            <if test="status != null">#{status},</if>
            <if test="publishTime != null">#{publishTime},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="creater != null">#{creater},</if>
            <if test="updater != null">#{updater},</if>
            <if test="deleted != null">#{deleted},</if>
        </trim>
    </insert>

    <update id="updateLifeAnnouncement" parameterType="LifeAnnouncement">
        update life_announcement
        <trim prefix="SET" suffixOverrides=",">
            <if test="title != null">title = #{title},</if>
            <if test="content != null">content = #{content},</if>
            <if test="type != null">type = #{type},</if>
            <if test="top != null">top = #{top},</if>
            <if test="status != null">status = #{status},</if>
            <if test="publishTime != null">publish_time = #{publishTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="updater != null">updater = #{updater},</if>
        </trim>
        where id = #{id} and deleted = 0
    </update>

    <!-- 条件更新: 仅草稿(0)/已撤回(2)可发布, 并发双击只生效一次 -->
    <update id="publishById">
        update life_announcement
        set status = 1, publish_time = #{publishTime}, update_time = #{publishTime}, updater = #{updater}
        where id = #{id} and deleted = 0 and status in (0, 2)
    </update>

    <!-- 条件更新: 仅已发布(1)可撤回 -->
    <update id="revokeById">
        update life_announcement
        set status = 2, update_time = now(), updater = #{updater}
        where id = #{id} and deleted = 0 and status = 1
    </update>

    <!-- 逻辑删除, 与C端 MyBatis-Plus @TableLogic 行为一致 -->
    <update id="deleteLifeAnnouncementById" parameterType="Long">
        update life_announcement set deleted = 1 where id = #{id}
    </update>

</mapper>
