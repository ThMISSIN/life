<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.life.mapper.LifeUserBenefitMapper">

    <resultMap type="LifeUserBenefit" id="LifeUserBenefitResult">
        <id     property="id"             column="id"/>
        <result property="userId"         column="user_id"/>
        <result property="nickname"       column="nickname"/>
        <result property="benefitId"      column="benefit_id"/>
        <result property="benefitName"    column="benefit_name"/>
        <result property="coverImage"     column="cover_image"/>
        <result property="orderNo"        column="order_no"/>
        <result property="code"           column="code"/>
        <result property="effectiveTime"  column="effective_time"/>
        <result property="expireTime"     column="expire_time"/>
        <result property="verifyTime"     column="verify_time"/>
        <result property="verifyOperator" column="verify_operator"/>
        <result property="status"         column="status"/>
        <result property="createTime"     column="create_time"/>
        <result property="updateTime"     column="update_time"/>
        <result property="creater"        column="creater"/>
        <result property="updater"        column="updater"/>
        <result property="deleted"        column="deleted"/>
    </resultMap>

    <sql id="selectUserBenefitVo">
        select ub.id, ub.user_id, ub.benefit_id, ub.benefit_name, ub.cover_image, ub.order_no, ub.code,
               ub.effective_time, ub.expire_time, ub.verify_time, ub.verify_operator, ub.status,
               ub.create_time, ub.update_time, ub.creater, ub.updater, ub.deleted,
               coalesce(nullif(u.nickname, ''), u.username) as nickname
        from life_user_benefit ub
        left join life_user u on u.id = ub.user_id and u.deleted = 0
    </sql>

    <!-- 管理端分页: 不限用户, 可按userId/benefitId/orderNo/code筛选, 时间降序(口径对齐C端 queryAdminPage)
         过期无落库状态: status=1(未使用) + expire_time与now比较 实时区分 未使用/已过期 -->
    <select id="selectLifeUserBenefitList" parameterType="com.ruoyi.life.domain.query.LifeUserBenefitQuery" resultMap="LifeUserBenefitResult">
        <include refid="selectUserBenefitVo"/>
        where ub.deleted = 0
        <if test="userId != null">
            and ub.user_id = #{userId}
        </if>
        <if test="benefitId != null">
            and ub.benefit_id = #{benefitId}
        </if>
        <if test="orderNo != null and orderNo != ''">
            and ub.order_no = #{orderNo}
        </if>
        <if test="code != null and code != ''">
            and ub.code = #{code}
        </if>
        <if test="benefitName != null and benefitName != ''">
            and ub.benefit_name like concat('%', #{benefitName}, '%')
        </if>
        <if test="userKeyword != null and userKeyword != ''">
            and (u.nickname like concat('%', #{userKeyword}, '%')
                 or u.username like concat('%', #{userKeyword}, '%'))
        </if>
        <if test="beginTime != null and beginTime != ''">
            and ub.create_time &gt;= #{beginTime}
        </if>
        <if test="endTime != null and endTime != ''">
            and ub.create_time &lt;= #{endTime}
        </if>
        <choose>
            <when test="status != null and status == 3">
                and ub.status = 1 and ub.expire_time &lt; now()
            </when>
            <when test="status != null and status == 1">
                and ub.status = 1 and ub.expire_time &gt;= now()
            </when>
            <when test="status != null">
                and ub.status = #{status}
            </when>
        </choose>
        order by ub.create_time desc, ub.id desc
    </select>

    <select id="selectLifeUserBenefitById" parameterType="Long" resultMap="LifeUserBenefitResult">
        <include refid="selectUserBenefitVo"/>
        where ub.deleted = 0 and ub.id = #{id}
    </select>

    <!-- 商家核销凭证查询: 按券码全局唯一键定位, 含昵称供二次确认 -->
    <select id="selectByCode" parameterType="String" resultMap="LifeUserBenefitResult">
        <include refid="selectUserBenefitVo"/>
        where ub.deleted = 0 and ub.code = #{code}
    </select>

    <select id="countActiveByBenefitId" parameterType="Long" resultType="int">
        select count(*) from life_user_benefit
        where deleted = 0 and benefit_id = #{benefitId} and status in (0, 1)
    </select>

    <update id="updateLifeUserBenefit" parameterType="LifeUserBenefit">
        update life_user_benefit
        <trim prefix="SET" suffixOverrides=",">
            <if test="status != null">status = #{status},</if>
            <if test="verifyTime != null">verify_time = #{verifyTime},</if>
            <if test="verifyOperator != null">verify_operator = #{verifyOperator},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="updater != null">updater = #{updater},</if>
        </trim>
        where id = #{id} and deleted = 0
    </update>

    <!-- 核销条件更新: 仅落库未使用(1)可置已使用(2), 并发双扫券码只生效一次 -->
    <update id="markVerified">
        update life_user_benefit
        set status = 2, verify_time = #{verifyTime}, verify_operator = #{verifyOperator},
            update_time = #{verifyTime}, updater = #{verifyOperator}
        where id = #{id} and deleted = 0 and status = 1
    </update>

</mapper>
