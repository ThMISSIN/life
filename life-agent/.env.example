# 应用
APP_NAME=enterprise-ai-agent
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# OpenAI / 兼容 API
OPENAI_API_KEY=sk-your-key
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agent_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_USER=
MILVUS_PASSWORD=
MILVUS_COLLECTION_NAME=agent_knowledge
MEMORY_COLLECTION_NAME=agent_memory

# 嵌入模型（本地 sentence-transformers；缺失时知识库/长期记忆自动降级）
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIM=512

# Agent 内部鉴权：与 Java 侧 life.agent.internal-token 保持一致；留空=不校验(仅限本地开发)
AGENT_INTERNAL_TOKEN=
AGENT_REACT_MAX_STEPS=10
AGENT_ENABLE_REFLECTION=true

# Java 主服务回连地址（业务工具网关 /ai-tools/*；留空=不注册平台业务工具）
JAVA_BASE_URL=http://127.0.0.1:8080

# 日志
LOG_LEVEL=INFO
